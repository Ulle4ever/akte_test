rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function account() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }
    function isTrainer() {
      return isSignedIn() && account().role == 'trainer';
    }
    // Team-beschraenkter Trainer-Zugang: account().teamId gesetzt -> darf nur sein
    // eigenes Team sehen/verwalten. Kein teamId-Feld (oder null) -> Vollzugriff.
    // Wichtig: erst mit 'in' pruefen, ob das Feld ueberhaupt existiert - direkter
    // Zugriff auf ein fehlendes Map-Feld wirft in Firestore-Regeln einen Fehler
    // (nicht einfach null), was sonst JEDE Anfrage bestehender Trainer-Zugaenge
    // ohne teamId-Feld mit "Missing or insufficient permissions" abgelehnt haette.
    function trainerTeamId() {
      return isTrainer() && ('teamId' in account()) ? account().teamId : null;
    }
    function isFullTrainer() {
      return isTrainer() && trainerTeamId() == null;
    }
    function myPlayerId() {
      return isSignedIn() && ('playerId' in account()) ? account().playerId : null;
    }
    function playerTeamId() {
      return isSignedIn() && myPlayerId() != null
        ? get(/databases/$(database)/documents/players/$(myPlayerId())).data.teamId
        : null;
    }
    // Team eines beliebigen Spielers (fuer team-beschraenkte Trainer-Pruefungen,
    // z.B. bei playerPrivate/playerWellness/playerGrades, wo der Dokument-Name
    // die Spieler-ID ist).
    function playerBelongsToTrainerTeam(playerId) {
      return isFullTrainer()
        || (isTrainer()
            && exists(/databases/$(database)/documents/players/$(playerId))
            && get(/databases/$(database)/documents/players/$(playerId)).data.teamId == trainerTeamId());
    }
    // Welche Teams ein Termin betrifft (eigenes Team + Teams einzeln eingeladener
    // Spieler), gepflegt vom Client im Feld involvedTeamIds. Fehlt das Feld (z.B.
    // sehr alte Termine von vor diesem Feature), gilt es als "betrifft niemanden
    // Bestimmtes" - sichtbar bleiben solche Termine fuer Vollzugriff-Trainer sowie
    // ueber die bestehenden spieler-bezogenen Regeln weiter unten.
    function eventInvolvesTrainerTeam(eventData) {
      return isFullTrainer()
        || (isTrainer()
            && 'involvedTeamIds' in eventData
            && trainerTeamId() in eventData.involvedTeamIds);
    }

    match /club/meta {
      allow read: if isSignedIn();
      // Club-weite Vorlagen (Teams anlegen, Statistik-Kategorien, Test-Arten) sind
      // Sache des Vollzugriff-Trainers - ein team-beschraenkter Trainer darf hier
      // nichts aendern.
      allow write: if isFullTrainer();
    }

    match /accounts/{uid} {
      // Zugaenge verwalten (anlegen/loeschen/einsehen) bleibt dem Vollzugriff-
      // Trainer vorbehalten - ein team-beschraenkter Trainer darf sich so nicht
      // selbst mehr Rechte geben. Den eigenen Account-Eintrag (z.B. Push-Token)
      // darf trotzdem jeder selbst lesen/schreiben.
      allow read: if isSignedIn() && (request.auth.uid == uid || isFullTrainer());
      allow write: if isFullTrainer() || request.auth.uid == uid;
    }

    // Öffentlichere Spieler-Daten: Stammdaten, Statistiken, Videos.
    // Vollzugriff-Trainer: alles. Team-beschraenkter Trainer: nur eigenes Team,
    // und darf einen Spieler weder aus einem anderen Team uebernehmen noch in ein
    // anderes Team verschieben. Verknüpfter Spieler-Zugang: lesen, und beim
    // eigenen Profil ausschließlich die Onboarding-/Kontaktfelder schreiben.
    match /players/{playerId} {
      allow read: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId())
        || myPlayerId() == playerId;
      allow create: if isFullTrainer()
        || (isTrainer() && request.resource.data.teamId == trainerTeamId());
      allow update: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId() && request.resource.data.teamId == trainerTeamId())
        || (myPlayerId() == playerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'birthdate', 'city', 'district', 'school', 'height', 'weight',
              'handedness', 'previousClub', 'phone', 'email',
              'emergencyContactName', 'emergencyContactPhone', 'onboardingCompleted'
            ]));
      allow delete: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId());
    }

    // Private Trainer-Daten pro Spieler: Notizen, Tests, Anwesenheit.
    // Ausschließlich Trainer (Vollzugriff oder das Team des Spielers), niemals der
    // Spieler-Zugang selbst.
    match /playerPrivate/{playerId} {
      allow read, write: if playerBelongsToTrainerTeam(playerId);
    }

    // Wellness-/Belastungs-Check-ins: Spieler tragen ihren eigenen Check-in selbst
    // ein. Trainer (Vollzugriff oder eigenes Team) sehen und verwalten die
    // Einträge ihrer Spieler.
    match /playerWellness/{playerId} {
      allow read, write: if playerBelongsToTrainerTeam(playerId) || myPlayerId() == playerId;
    }

    // Noten-Umfrage: Fächer/Zeugnisnoten/Klausurnoten trägt der Spieler für sich
    // selbst ein. Trainer (Vollzugriff oder eigenes Team) sehen und verwalten alle
    // Einträge ihrer Spieler.
    match /playerGrades/{playerId} {
      allow read, write: if playerBelongsToTrainerTeam(playerId) || myPlayerId() == playerId;
    }

    // Kalender: Team-Termine sind für Trainer und Spieler desselben Teams lesbar,
    // individuelle Termine für Trainer und ausdrücklich eingeladene Spieler -
    // inkl. team-beschraenkter Trainer, deren eigener Spieler bei einem Termin
    // eines anderen Teams einzeln eingeladen ist (involvedTeamIds). Anlegen/Ändern
    // eines ganzen Team-Termins bleibt Sache des jeweiligen Team-Trainers; ein
    // individueller Termin (kein Team, nur einzelne Spieler) darf von jedem
    // Trainer verwaltet werden, dessen eigenes Team daran beteiligt ist.
    match /calendarEvents/{eventId} {
      allow read: if eventInvolvesTrainerTeam(resource.data)
        || resource.data.teamId == playerTeamId()
        || myPlayerId() in resource.data.includedPlayerIds;
      allow create: if isFullTrainer()
        || (isTrainer() && request.resource.data.teamId == trainerTeamId())
        || (isTrainer() && request.resource.data.teamId == null
            && 'involvedTeamIds' in request.resource.data
            && trainerTeamId() in request.resource.data.involvedTeamIds);
      allow update, delete: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId())
        || (isTrainer() && resource.data.teamId == null && eventInvolvesTrainerTeam(resource.data));
    }

    // Team-Notizen/Dateien: gehören zu einem Team, aber ein Spieler-Zugang
    // sieht nur die Notizen, die ein Trainer ausdrücklich für ihn freigegeben hat
    // (sharedWithPlayerIds). Trainer (Vollzugriff oder eigenes Team) sehen und
    // verwalten die Notizen ihres Teams.
    match /teamNotes/{noteId} {
      allow read: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId())
        || myPlayerId() in resource.data.sharedWithPlayerIds
        || (resource.data.sharedWithAll == true && resource.data.teamId == playerTeamId());
      allow create: if isFullTrainer()
        || (isTrainer() && request.resource.data.teamId == trainerTeamId());
      allow update, delete: if isFullTrainer()
        || (isTrainer() && resource.data.teamId == trainerTeamId());
    }

    // Rotationspläne: reines (aktuell ungenutztes) Vorbereitungs-Werkzeug, bleibt
    // dem Vollzugriff-Trainer vorbehalten.
    match /rotationPlans/{planId} {
      allow read, write: if isFullTrainer();
    }

    // Anwesenheit pro Einheit (direkt in "Alle Einheiten"/"Anwesenheit" markiert).
    // Dokument-ID = Termin-ID - Zugriff folgt exakt der Sichtbarkeit des
    // zugehoerigen Termins.
    match /eventAttendance/{eventId} {
      allow read, write: if isFullTrainer()
        || (isTrainer()
            && exists(/databases/$(database)/documents/calendarEvents/$(eventId))
            && eventInvolvesTrainerTeam(get(/databases/$(database)/documents/calendarEvents/$(eventId)).data));
    }

    // Player Development Plan, aufgeteilt in drei Dokumente pro Zyklus (gleiche ID):
    // - devPlanPlayer: vom Spieler selbst ausgefüllt, der Spieler darf sein eigenes schreiben
    // - devPlanTrainer: vom Trainer ausgefüllt, für den Spieler erst nach Freigabe lesbar
    // - devPlanCombined: im Meeting gemeinsam ausgefüllt, nur Trainer schreibt, beide lesen
    // Trainer-Zugriff jeweils Vollzugriff oder eigenes Team (ueber den Spieler).
    match /devPlanPlayer/{id} {
      allow read: if playerBelongsToTrainerTeam(resource.data.playerId) || myPlayerId() == resource.data.playerId;
      allow create: if playerBelongsToTrainerTeam(request.resource.data.playerId) || myPlayerId() == request.resource.data.playerId;
      allow update, delete: if playerBelongsToTrainerTeam(resource.data.playerId) || myPlayerId() == resource.data.playerId;
    }
    match /devPlanTrainer/{id} {
      allow read: if playerBelongsToTrainerTeam(resource.data.playerId) || (myPlayerId() == resource.data.playerId && resource.data.released == true);
      allow create: if playerBelongsToTrainerTeam(request.resource.data.playerId);
      allow update, delete: if playerBelongsToTrainerTeam(resource.data.playerId);
    }
    match /devPlanCombined/{id} {
      allow read: if playerBelongsToTrainerTeam(resource.data.playerId) || myPlayerId() == resource.data.playerId;
      allow create: if playerBelongsToTrainerTeam(request.resource.data.playerId);
      allow update, delete: if playerBelongsToTrainerTeam(resource.data.playerId);
    }
  }
}
